<Window
    x:Class="HeatingCameraSystem.Master.Views.AlarmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:HeatingCameraSystem.Master.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="{loc:Loc Alarm_WindowTitle}"
    Width="900"
    Height="700"
    Background="#151a24"
    Icon="/Assets/canlab.ico"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="AlarmActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2f3444" />
            <Setter Property="Foreground" Value="#e6edf3" />
            <Setter Property="BorderBrush" Value="#4a5468" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding BuzzerOffCommand}" Content="{loc:Loc Alarm_BtnBuzzerOff}" Style="{StaticResource AlarmActionButton}" />
            <Button Command="{Binding ResetErrorCommand}" Content="{loc:Loc Alarm_BtnResetError}" Style="{StaticResource AlarmActionButton}" />
            <Border Width="1" Background="#3b4453" Margin="6,2,14,2" />
            <Button Command="{Binding DeleteSelectedCommand}" Content="{loc:Loc Alarm_BtnDelete}" Style="{StaticResource AlarmActionButton}" IsEnabled="{Binding HasSelection}" />
            <Button Command="{Binding ClearAlarmsCommand}" Content="{loc:Loc Alarm_BtnClear}" Style="{StaticResource AlarmActionButton}" ToolTip="{loc:Loc Alarm_ClearHint}" />
            <TextBlock Text="{Binding ActionMessage}" Foreground="#8fa0b0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc Nav_AlarmsFilterType}" Foreground="#8fa0b0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" Width="160" ItemsSource="{Binding AlarmFilters}" SelectedItem="{Binding SelectedAlarmFilter, Mode=TwoWay}" DisplayMemberPath="Label" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Height="220" Background="#1b212c" BorderBrush="#3b4453" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Alarm_DetailTitle}" Foreground="#9fb0c0" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedAlarm.Message}" Foreground="#e6edf3" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Loc Alarm_Cause}" Foreground="#ffb37a" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding CauseText}" Foreground="#bac9c9" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBlock Text="{loc:Loc Alarm_Action}" Foreground="#7ad6a0" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding ActionText}" Foreground="#bac9c9" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Background="#1b212c" BorderBrush="#3b4453" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBlock Text="{loc:Loc Nav_AlarmsEmpty}" Foreground="#8fa0b0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredAlarms.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox
                    ItemsSource="{Binding FilteredAlarms}"
                    SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Foreground="#8fa0b0" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#243040" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Background" Value="#5a1512" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Background" Value="#4a3512" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#9fb0c0" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#e6edf3" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>
