<UserControl x:Class="HeatingCameraSystem.Master.Views.CapturePlanBoardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextOnSurface}">
 <UserControl.Resources>
  <SolidColorBrush x:Key="BgSurface" Color="#0e1321"/>
  <SolidColorBrush x:Key="BgSurfaceContainer" Color="#1a1f2e"/>
  <SolidColorBrush x:Key="BgSurfaceVariant" Color="#2f3444"/>
  <SolidColorBrush x:Key="OutlineVariant" Color="#3b4949"/>
  <SolidColorBrush x:Key="TextOnSurface" Color="#dee2f7"/>
  <SolidColorBrush x:Key="Error" Color="#ffb4ab"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextOnSurface}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource TextOnSurface}"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{StaticResource TextOnSurface}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" Background="{StaticResource BgSurfaceContainer}" Padding="12,8" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgSurfaceVariant}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Summary}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Grid.Row="1" Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Error}" Margin="0,0,0,12"/>
  <TabControl Grid.Row="2" x:Name="EntryTabs" ItemsSource="{Binding Entries}" SelectedIndex="{Binding SelectedEntryIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" Background="{DynamicResource BgSurfaceContainer}">
   <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="8,4"/></DataTemplate></TabControl.ItemTemplate>
   <TabControl.ContentTemplate><DataTemplate>
    <ListBox x:Name="CellsList" ItemsSource="{Binding Cells}" Background="{DynamicResource BgSurfaceContainer}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" Padding="12" CornerRadius="4">
       <StackPanel>
        <DockPanel><TextBlock Text="{Binding Label}" DockPanel.Dock="Right" FontWeight="Bold" Margin="16,0,0,0"/><TextBlock Text="{Binding CameraLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{DynamicResource Error}" Margin="0,6,0,0"/>
        <ItemsControl ItemsSource="{Binding Captures}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DataTemplate></TabControl.ContentTemplate>
  </TabControl>
 </Grid>
</UserControl>
