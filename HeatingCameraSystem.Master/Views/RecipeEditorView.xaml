<UserControl x:Class="HeatingCameraSystem.Master.Views.RecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:HeatingCameraSystem.Master.Localization" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HeatingCameraSystem.Master.Views"
             xmlns:vm="clr-namespace:HeatingCameraSystem.Master.ViewModels"
             xmlns:model="clr-namespace:HeatingCameraSystem.Core.Models;assembly=HeatingCameraSystem.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024" Background="#0e1321" Foreground="#dee2f7">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="BgSurface" Color="#0e1321"/>
        <SolidColorBrush x:Key="BgSurfaceContainer" Color="#1a1f2e"/>
        <SolidColorBrush x:Key="BgSurfaceVariant" Color="#2f3444"/>
        <SolidColorBrush x:Key="OutlineVariant" Color="#3b4949"/>
        <SolidColorBrush x:Key="Primary" Color="#47eaed"/>
        <SolidColorBrush x:Key="Secondary" Color="#4ae183"/>
        <SolidColorBrush x:Key="Error" Color="#ffb4ab"/>
        <SolidColorBrush x:Key="TextOnSurface" Color="#dee2f7"/>
        <SolidColorBrush x:Key="TextOnSurfaceVariant" Color="#bac9c9"/>
        
        <Style x:Key="ListItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceContainer}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OutlineVariant}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceVariant}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderThickness" Value="4,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MotorStepTemplate">
            <Border Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12"
                    AllowDrop="True" DragEnter="Step_DragEnter" Drop="Step_Drop" MouseLeftButtonUp="Step_Select">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="☰" FontSize="18" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,12,0" Cursor="SizeAll" PreviewMouseLeftButtonDown="Step_PreviewMouseLeftButtonDown" MouseMove="Step_MouseMove"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepNumber, StringFormat='#{0}'}" Foreground="{StaticResource Primary}" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock Text="PLC 모터 이동" Foreground="{StaticResource TextOnSurface}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="X" Foreground="{StaticResource TextOnSurfaceVariant}" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0" Width="100"><TextBlock Text="이동 타입" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><ComboBox ItemsSource="{Binding DataContext.MotorMoveTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValuePath="Value" SelectedValue="{Binding MotorMoveType}" DisplayMemberPath="Label" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}"/></StackPanel>
                        <StackPanel Margin="0,0,16,0" Width="100" Visibility="{Binding ShowsManualCoordinates, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="X (mm)" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding PositionX}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel Margin="0,0,16,0" Width="100" Visibility="{Binding ShowsManualCoordinates, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Y (mm)" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding PositionY}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel Width="100" Visibility="{Binding ShowsAutomaticPoint, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="POINT (1-20)" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><ComboBox ItemsSource="{Binding DataContext.ServoPointOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding TargetPositionIndex}" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}"/></StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChamberStepTemplate">
            <Border Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12"
                    AllowDrop="True" DragEnter="Step_DragEnter" Drop="Step_Drop" MouseLeftButtonUp="Step_Select">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="☰" FontSize="18" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,12,0" Cursor="SizeAll" PreviewMouseLeftButtonDown="Step_PreviewMouseLeftButtonDown" MouseMove="Step_MouseMove"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepNumber, StringFormat='#{0}'}" Foreground="{StaticResource Primary}" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock Text="PLC 온습도 설정" Foreground="{StaticResource TextOnSurface}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="X" Foreground="{StaticResource TextOnSurfaceVariant}" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0"><TextBlock Text="CHAMBER °C" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding TargetChamberTemperature}" Width="100" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel Margin="0,0,16,0"><TextBlock Text="CHAMBER %RH" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding TargetChamberHumidity}" Width="100" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel Width="170">
                            <TextBlock Text="진행 방식" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding WaitForChamberStabilization}" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}">
                                <ComboBoxItem Content="온·습도 도달까지 대기"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                <ComboBoxItem Content="설정만 하고 진행"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CameraStepTemplate">
            <Border Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12"
                    AllowDrop="True" DragEnter="Step_DragEnter" Drop="Step_Drop" MouseLeftButtonUp="Step_Select">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="☰" FontSize="18" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,12,0" Cursor="SizeAll" PreviewMouseLeftButtonDown="Step_PreviewMouseLeftButtonDown" MouseMove="Step_MouseMove"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepNumber, StringFormat='#{0}'}" Foreground="{StaticResource Primary}" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock Text="카메라 명령" Foreground="{StaticResource TextOnSurface}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="X" Foreground="{StaticResource TextOnSurfaceVariant}" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0" Width="170">
                            <TextBlock Text="CAMERA COMMAND" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                            <ComboBox ItemsSource="{Binding DataContext.CameraOperationOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValuePath="Value" SelectedValue="{Binding CameraOperation}" DisplayMemberPath="Label" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}"/>
                        </StackPanel>
                        <StackPanel Width="260">
                            <TextBlock Text="대상 카메라 (복수 선택)" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                            <ComboBox ItemsSource="{Binding CameraTargets}" IsEditable="True" IsReadOnly="True" Text="{Binding SelectedCameraSummary, Mode=OneWay}" StaysOpenOnEdit="True" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{StaticResource TextOnSurface}" PreviewMouseDown="CameraTargetCheckBox_PreviewMouseDown"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BlackBodyStepTemplate">
            <Border Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12"
                    AllowDrop="True" DragEnter="Step_DragEnter" Drop="Step_Drop" MouseLeftButtonUp="Step_Select">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="☰" FontSize="18" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,12,0" Cursor="SizeAll" PreviewMouseLeftButtonDown="Step_PreviewMouseLeftButtonDown" MouseMove="Step_MouseMove"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepNumber, StringFormat='#{0}'}" Foreground="{StaticResource Primary}" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock Text="블랙바디 온도 제어" Foreground="{StaticResource TextOnSurface}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="X" Foreground="{StaticResource TextOnSurfaceVariant}" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0" Width="80">
                            <TextBlock Text="BB 0 설정" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                            <TextBox Text="{Binding BlackbodyRef}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" Width="100">
                            <TextBlock Text="BB 1 설정 °C" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                            <TextBox Text="{Binding BlackbodyRef1}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/>
                        </StackPanel>
                        <StackPanel Width="170">
                            <TextBlock Text="진행 방식" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding WaitForStabilization}" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}">
                                <ComboBoxItem Content="온도 도달까지 대기"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                <ComboBoxItem Content="설정만 하고 진행"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LegacyStepTemplate">
            <Border Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12"
                    AllowDrop="True" DragEnter="Step_DragEnter" Drop="Step_Drop" MouseLeftButtonUp="Step_Select">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="☰" FontSize="18" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,12,0" Cursor="SizeAll" PreviewMouseLeftButtonDown="Step_PreviewMouseLeftButtonDown" MouseMove="Step_MouseMove"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepNumber, StringFormat='#{0}'}" Foreground="{StaticResource Primary}" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock Text="기존 일괄 촬영" Foreground="{StaticResource TextOnSurface}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="X" Foreground="{StaticResource TextOnSurfaceVariant}" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0" Width="220"><TextBlock Text="NODE ASSIGNMENT" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding NodeAssignment}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel Margin="0,0,16,0"><TextBlock Text="BLACKBODY REF" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding BlackbodyRef}" Width="80" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel Margin="0,0,16,0"><TextBlock Text="X (mm)" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding PositionX}" Width="80" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                        <StackPanel><TextBlock Text="Y (mm)" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}"/><TextBox Text="{Binding PositionY}" Width="80" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"/></StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Recipes List -->
        <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="0,0,0,1" Padding="16">
                    <TextBlock Text="Recipes" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextOnSurface}"/>
                </Border>
                
                <ScrollViewer Grid.Row="1" Margin="8,8,8,0">
                    <ItemsControl ItemsSource="{Binding Recipes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListItemBorderStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectRecipeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Name="RecipeNameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="14" Background="Transparent" BorderThickness="0" Margin="-2,0,0,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="{StaticResource TextOnSurface}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Grid.Row="1" Text="{Binding LastModified, StringFormat='MODIFIED: {0}'}" FontSize="10" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Border Grid.Row="2" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="{loc:Loc Recipe_NewRecipe}" Command="{Binding AddRecipeCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource Primary}" BorderThickness="0" Margin="0,0,4,0" Padding="0,8"/>
                        <Button Grid.Column="1" Content="{loc:Loc Recipe_CopyRecipe}" Command="{Binding CopyRecipeCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource Secondary}" BorderThickness="0" Margin="4,0,4,0" Padding="0,8"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_Delete}" Command="{Binding DeleteRecipeCommand}" CommandParameter="{Binding SelectedRecipe}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource Error}" BorderThickness="0" Margin="4,0,0,0" Padding="0,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Panel: Main Editor Workspace -->
        <Border Grid.Column="1" Background="#090e1c">
            <Grid DataContext="{Binding SelectedRecipe}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Recipe Settings Top Section -->
                <Border Grid.Row="0" Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="0,0,0,1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Recipe Settings" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextOnSurface}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" Visibility="Collapsed">
                                <TextBlock Text="TARGET CHAMBER TEMP" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TargetChamberTemp}" Background="Transparent" Foreground="{StaticResource Primary}" BorderThickness="0" FontSize="18" FontWeight="Bold" Width="60"/>
                                        <TextBlock Text="°C" Foreground="{StaticResource TextOnSurfaceVariant}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,16,0" Visibility="Collapsed">
                                <TextBlock Text="{loc:Loc Recipe_TempRampTime}" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding RampMinutes}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" FontSize="18" FontWeight="Bold" Width="60"/>
                                        <TextBlock Text="{loc:Loc Common_Minute}" Foreground="{StaticResource TextOnSurfaceVariant}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0" Visibility="Collapsed">
                                <TextBlock Text="TARGET CHAMBER HUMIDITY" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TargetChamberHumidity}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" FontSize="18" FontWeight="Bold" Width="60"/>
                                        <TextBlock Text="%RH" Foreground="{StaticResource TextOnSurfaceVariant}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="CAPTURE MODE" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Padding="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Note: using simplistic toggle buttons or regular buttons binding to a command. -->
                                        <!-- This is just a placeholder look -->
                                        <Button Grid.Column="0" Content="Sequential" Background="{StaticResource Primary}" Foreground="#002020" BorderThickness="0" FontWeight="Bold" Padding="0,8"/>
                                        <Button Grid.Column="1" Content="Simultaneous" Background="Transparent" Foreground="{StaticResource TextOnSurfaceVariant}" BorderThickness="0" Padding="0,8"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Recipe_SafetyTempTolerance}" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SafetyTempTolerance}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" FontSize="18" FontWeight="Bold" Width="60"/>
                                        <TextBlock Text="°C" Foreground="{StaticResource TextOnSurfaceVariant}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Recipe_SafetyHumidityTolerance}" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SafetyHumidityTolerance}" Background="Transparent" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" FontSize="18" FontWeight="Bold" Width="60"/>
                                        <TextBlock Text="%RH" Foreground="{StaticResource TextOnSurfaceVariant}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Steps Scroll Area -->
                <ScrollViewer Grid.Row="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="STEPS (DRAG TO REORDER)" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,8"/>
                        
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource LegacyStepTemplate}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:RecipeStepKind.MotorMove}"><Setter Property="ContentTemplate" Value="{StaticResource MotorStepTemplate}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:RecipeStepKind.ChamberControl}"><Setter Property="ContentTemplate" Value="{StaticResource ChamberStepTemplate}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:RecipeStepKind.CameraCommand}"><Setter Property="ContentTemplate" Value="{StaticResource CameraStepTemplate}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:RecipeStepKind.BlackBodyControl}"><Setter Property="ContentTemplate" Value="{StaticResource BlackBodyStepTemplate}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <WrapPanel Margin="0,16,0,0">
                            <Button Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{x:Static model:RecipeStepKind.MotorMove}" Content="+ PLC 모터 이동" Background="Transparent" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="2" Foreground="{StaticResource TextOnSurfaceVariant}" Padding="14,10" Margin="0,0,8,8" Cursor="Hand"/>
                            <Button Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{x:Static model:RecipeStepKind.ChamberControl}" Content="+ PLC 온습도 설정" Background="Transparent" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="2" Foreground="{StaticResource TextOnSurfaceVariant}" Padding="14,10" Margin="0,0,8,8" Cursor="Hand"/>
                            <Button Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{x:Static model:RecipeStepKind.CameraCommand}" Content="+ 카메라 명령" Background="Transparent" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="2" Foreground="{StaticResource TextOnSurfaceVariant}" Padding="14,10" Margin="0,0,8,8" Cursor="Hand"/>
                            <Button Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{x:Static model:RecipeStepKind.BlackBodyControl}" Content="+ 블랙바디 온도 제어" Background="Transparent" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="2" Foreground="{StaticResource TextOnSurfaceVariant}" Padding="14,10" Margin="0,0,8,8" Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Bar Actions -->
                <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Secondary}" Margin="0,0,8,0"/>
                            <TextBlock Text="DB CONNECTION STABLE" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="IMPORT" Command="{Binding ImportRecipeCommand}" Background="Transparent" Foreground="{StaticResource Primary}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" Padding="24,8" Margin="0,0,8,0" FontWeight="Bold"/>
                            <Button Content="EXPORT" Command="{Binding ExportRecipeCommand}" Background="Transparent" Foreground="{StaticResource Primary}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" Padding="24,8" Margin="0,0,16,0" FontWeight="Bold"/>
                            <Button Content="CANCEL" Background="Transparent" Foreground="{StaticResource TextOnSurfaceVariant}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" Padding="24,8" Margin="0,0,16,0" FontWeight="Bold"/>
                            <Button Content="SAVE RECIPE" Command="{Binding DataContext.SaveRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="{StaticResource Secondary}" Foreground="#00210c" BorderThickness="0" Padding="32,8" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Column 2: LIVE PREVIEW & MOTION -->
        <Border Grid.Column="2" Background="{StaticResource BgSurfaceContainer}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="LIVE PREVIEW &amp; MOTION" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextOnSurface}" Margin="0,0,0,16"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="{loc:Loc Recipe_OnlineAgentCameras}" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding OnlineAgentCameras}" SelectedItem="{Binding SelectedPreviewCamera}" DisplayMemberPath="Label" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}"/>
                </StackPanel>

                <Border Grid.Row="2" Background="Black" Width="380" Height="285" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Image Source="{Binding CurrentPreview}" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Secondary}">
                        <Run Text="X: "/>
                        <Run Text="{Binding CurrentServoX}"/>
                        <Run Text=" / Y: "/>
                        <Run Text="{Binding CurrentServoY}"/>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="XY TARGET" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox Text="{Binding SelectedStep.PositionX, StringFormat={}{0:F1}}" Width="60" Margin="0,0,8,0" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="4"/>
                            <TextBox Text="{Binding SelectedStep.PositionY, StringFormat={}{0:F1}}" Width="60" Margin="0,0,8,0" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="4"/>
                            <Button Content="GO TO XY" Command="{Binding GoToXyCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="USE CURRENT X" Command="{Binding UseCurrentXCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="USE CURRENT Y" Command="{Binding UseCurrentYCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="HOME" Command="{Binding HomeServoCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4"/>
                        </StackPanel>
                        
                        <TextBlock Text="SHUTTER &amp; CAMERA" FontSize="11" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="SHUTTER OPEN" Command="{Binding OpenShutterCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="SHUTTER CLOSE" Command="{Binding CloseShutterCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="CAMERA START" Command="{Binding StartCameraCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="CAMERA STOP" Command="{Binding StopCameraCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4"/>
                            <Button Content="CAPTURE" Command="{Binding CaptureCameraCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="8,0,0,0"/>
                            <Button Content="NUC" Command="{Binding RunNucCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="8,0,0,0"/>
                            <Button Content="BIAS LOW" Command="{Binding RunBiasLowCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="8,0,0,0"/>
                            <Button Content="BIAS MID" Command="{Binding RunBiasMidCommand}" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Padding="8,4" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="1" Tag="Y+" PreviewMouseDown="Jog_Down" PreviewMouseUp="Jog_Up" MouseLeave="Jog_Up" Content="Y+" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Margin="2"/>
                        <Button Grid.Row="1" Grid.Column="0" Tag="X-" PreviewMouseDown="Jog_Down" PreviewMouseUp="Jog_Up" MouseLeave="Jog_Up" Content="X-" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Margin="2"/>
                        <Button Grid.Row="1" Grid.Column="2" Tag="X+" PreviewMouseDown="Jog_Down" PreviewMouseUp="Jog_Up" MouseLeave="Jog_Up" Content="X+" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Margin="2"/>
                        <Button Grid.Row="2" Grid.Column="1" Tag="Y-" PreviewMouseDown="Jog_Down" PreviewMouseUp="Jog_Up" MouseLeave="Jog_Up" Content="Y-" Background="{StaticResource BgSurface}" Foreground="{StaticResource TextOnSurface}" BorderThickness="0" Margin="2"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
