<UserControl x:Class="HeatingCameraSystem.Master.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HeatingCameraSystem.Master.Views"
             xmlns:vm="clr-namespace:HeatingCameraSystem.Master.ViewModels"
             xmlns:conv="clr-namespace:HeatingCameraSystem.Master.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600" Background="#0b0f1a" Foreground="#dee2f7">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:BoolToBrushConverter x:Key="Lamp"    OnBrush="#4ae183" OffBrush="#243040"/>
        <conv:BoolToBrushConverter x:Key="ErrLamp" OnBrush="#ff5b52" OffBrush="#243040"/>
        <conv:BoolToBrushConverter x:Key="PlcLamp" OnBrush="#4ae183" OffBrush="#ff5b52"/>

        <SolidColorBrush x:Key="BgSurface"            Color="#0e1321"/>
        <SolidColorBrush x:Key="BgSurfaceContainer"   Color="#1a1f2e"/>
        <SolidColorBrush x:Key="BgSurfaceVariant"     Color="#2f3444"/>
        <SolidColorBrush x:Key="OutlineVariant"       Color="#3b4949"/>
        <SolidColorBrush x:Key="Outline"              Color="#859493"/>
        <SolidColorBrush x:Key="Primary"              Color="#47eaed"/>
        <SolidColorBrush x:Key="Secondary"            Color="#4ae183"/>
        <SolidColorBrush x:Key="Error"                Color="#ffb4ab"/>
        <SolidColorBrush x:Key="TextOnSurface"        Color="#dee2f7"/>
        <SolidColorBrush x:Key="TextOnSurfaceVariant" Color="#bac9c9"/>
        <SolidColorBrush x:Key="CardEdge"             Color="#26414d"/>

        <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#171f30" Offset="0"/>
            <GradientStop Color="#0d1320" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextOnSurfaceVariant}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextOnSurface}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Outline}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="3,0,0,4"/>
        </Style>
        <Style x:Key="LampCell" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,3,14,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#10192a"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnSurfaceVariant}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgSurfaceVariant}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="1"/>
                        <Condition Binding="{Binding Path=DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="2"/>
                        <Condition Binding="{Binding Path=DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="3"/>
                        <Condition Binding="{Binding Path=DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="4"/>
                        <Condition Binding="{Binding Path=DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="5"/>
                        <Condition Binding="{Binding Path=DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="5"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ EMERGENCY BANNER (visible only when 비상정지) ═══ -->
        <Border Grid.Row="0" Padding="24,12" Visibility="{Binding IsEmergencyStop, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#5a1512" Offset="0"/>
                    <GradientStop Color="#a11f18" Offset="0.5"/>
                    <GradientStop Color="#5a1512" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#ff5b52" BlurRadius="24" ShadowDepth="0" Opacity="0.75"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#x26A0;" FontSize="20" Foreground="#ffe1de" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="EMERGENCY STOP ACTIVE  ·  비상정지 동작 중" FontSize="18" FontWeight="Bold" Foreground="#ffe1de" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ TOP HUD STATUS BAR ═══ -->
        <Border Grid.Row="1" Background="#10192a" BorderBrush="{StaticResource CardEdge}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource Primary}" Margin="0,0,12,0">
                            <Border.Effect><DropShadowEffect Color="#47eaed" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                        </Border>
                        <TextBlock Text="SYSTEM OVERVIEW" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextOnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="실시간 통합 모니터링 · 2s REFRESH" FontSize="11" Foreground="{StaticResource Outline}" Margin="16,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PLC connection -->
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding IsPlcConnected, Converter={StaticResource PlcLamp}}" Margin="0,0,8,0">
                                <Ellipse.Effect><DropShadowEffect Color="#4ae183" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="PLC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlcStatusMessage}" FontSize="11" Foreground="{StaticResource TextOnSurface}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Agents online -->
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Secondary}" Margin="0,0,8,0"/>
                            <TextBlock Text="AGENTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OnlineAgentCount, StringFormat={}{0} ONLINE}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Current point -->
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="POINT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentPoint}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Alarms -->
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x26A0;" FontSize="12" Foreground="#ffcf6b" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ALARMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnSurfaceVariant}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Alarms.Count}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#ff5b52"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Alarms.Count}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BODY : Telemetry | Cameras | Agents+Recipe ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- ─── COL 0 : TELEMETRY CARDS ─── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16,16,10,16">
                <StackPanel>

                    <!-- CHAMBER -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CHAMBER · 챔버 온습도" Style="{StaticResource CardHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="온도 TEMP" Style="{StaticResource Lbl}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentTemperature, StringFormat={}{0:F1}}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Error}">
                                            <TextBlock.Effect><DropShadowEffect Color="#ffb4ab" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="&#176;C" Style="{StaticResource Unit}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TargetTemperature, StringFormat=목표 {0:F1}&#176;C}" FontSize="11" Foreground="{StaticResource Outline}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="습도 HUMIDITY" Style="{StaticResource Lbl}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentHumidity, StringFormat={}{0:F1}}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Primary}">
                                            <TextBlock.Effect><DropShadowEffect Color="#47eaed" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="%RH" Style="{StaticResource Unit}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TargetHumidity, StringFormat=목표 {0:F1}%RH}" FontSize="11" Foreground="{StaticResource Outline}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="64" Margin="0,12,0,0" Background="#0a1019" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="6" Padding="6">
                                <Grid>
                                    <TextBlock Text="트렌드 수집 중…" Foreground="{StaticResource Outline}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemperatureTrendPoints.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="100" Height="40">
                                            <Polyline Points="{Binding TemperatureTrendPoints}" Stroke="#ffb4ab" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                            <Polyline Points="{Binding HumidityTrendPoints}" Stroke="{StaticResource Primary}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BLACKBODY -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="BLACKBODY · 흑체" Style="{StaticResource CardHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="흑체 1 현재 (PV)" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlackBody1Pv, StringFormat={}{0:F1} &#176;C}" Style="{StaticResource Val}" Foreground="{StaticResource Primary}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="흑체 1 목표 (SV)" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BlackBody1Sv, StringFormat={}{0:F1} &#176;C}" Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="흑체 2 현재 (PV)" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BlackBody2Pv, StringFormat={}{0:F1} &#176;C}" Style="{StaticResource Val}" Foreground="{StaticResource Primary}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="흑체 2 목표 (SV)" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BlackBody2Sv, StringFormat={}{0:F1} &#176;C}" Style="{StaticResource Val}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- MOTION / SERVO -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MOTION · 서보 직교로봇" Style="{StaticResource CardHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="X POSITION" Style="{StaticResource Lbl}"/>
                                    <TextBlock Text="{Binding ServoXPosition}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary}">
                                        <TextBlock.Effect><DropShadowEffect Color="#47eaed" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="Y POSITION" Style="{StaticResource Lbl}" Margin="0,8,8,5"/>
                                    <TextBlock Text="{Binding ServoYPosition}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary}">
                                        <TextBlock.Effect><DropShadowEffect Color="#47eaed" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CurrentPoint, StringFormat=현재 포인트 · P{0}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Secondary}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <!-- XY mini-map -->
                                <Border Grid.Column="1" Width="126" Height="126" VerticalAlignment="Center" Background="#080d15" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Border Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#1c2b38"/>
                                        <Border Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#1c2b38"/>
                                        <Ellipse Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource Secondary}">
                                            <Ellipse.Effect><DropShadowEffect Color="#4ae183" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="{StaticResource CardEdge}" Margin="0,12,0,10"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource LampCell}">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ServoXBusy, Converter={StaticResource Lamp}}"/><TextBlock Text=" X BUSY" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource LampCell}">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ServoYBusy, Converter={StaticResource Lamp}}"/><TextBlock Text=" Y BUSY" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource LampCell}">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ServoXHomeComplete, Converter={StaticResource Lamp}}"/><TextBlock Text=" X 원점" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource LampCell}">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ServoYHomeComplete, Converter={StaticResource Lamp}}"/><TextBlock Text=" Y 원점" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                            </WrapPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X 에러코드" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServoXErrorCode}" Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y 에러코드" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServoYErrorCode}" Style="{StaticResource Val}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PROGRAM -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROGRAM · 진행" Style="{StaticResource CardHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="스텝 STEP" Style="{StaticResource Lbl}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Val}" Foreground="{StaticResource Primary}" Margin="0"/>
                                    <TextBlock Text="{Binding TotalSteps, StringFormat= / {0}}" Style="{StaticResource Val}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="팬 속도 FAN" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FanSpeedHz, StringFormat={}{0:F2} Hz}" Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="GAS 유속" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GasFlow, StringFormat={}{0:F1}}" Style="{StaticResource Val}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- EQUIPMENT -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EQUIPMENT · 장비 상태" Style="{StaticResource CardHeader}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding Heater, Converter={StaticResource Lamp}}"/><TextBlock Text=" 히터" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding Cooler1st, Converter={StaticResource Lamp}}"/><TextBlock Text=" 1차 냉동" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding Cooler2nd, Converter={StaticResource Lamp}}"/><TextBlock Text=" 2차 냉동" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding CoolerRoom, Converter={StaticResource Lamp}}"/><TextBlock Text=" 상온 냉동" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding CoolerRoomBypass, Converter={StaticResource Lamp}}"/><TextBlock Text=" 바이패스" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding DoorLamp, Converter={StaticResource Lamp}}"/><TextBlock Text=" 도어램프" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding PairGlass, Converter={StaticResource Lamp}}"/><TextBlock Text=" 페어글라스" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding Mcf, Converter={StaticResource Lamp}}"/><TextBlock Text=" MCF" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding Blower1, Converter={StaticResource Lamp}}"/><TextBlock Text=" 블로워1" Style="{StaticResource Lbl}"/></StackPanel>
                                <StackPanel Style="{StaticResource LampCell}"><Ellipse Width="10" Height="10" Fill="{Binding Blower2, Converter={StaticResource Lamp}}"/><TextBlock Text=" 블로워2" Style="{StaticResource Lbl}"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ALARMS -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveErrors}" Value="True">
                                        <Setter Property="BorderBrush" Value="#ff5b52"/>
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#ff5b52" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="ALARMS · 알람" Style="{StaticResource CardHeader}" Margin="0"/>
                                <TextBlock Text="{Binding Alarms.Count, StringFormat={}{0}건}" FontSize="11" FontWeight="Bold" Foreground="#ff8f88" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Alarms.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="정상 · ALL SYSTEMS NOMINAL" Foreground="{StaticResource TextOnSurfaceVariant}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Alarms.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding Alarms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Outline}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Border Grid.Column="1" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#243040"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Background" Value="#5a1512"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Background" Value="#4a3512"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextOnSurface}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextOnSurface}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── COL 1 : CAMERA FEEDS ─── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#10192a" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="16,16,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Mode 1 (Auto 8)" Style="{StaticResource ModeButtonStyle}" Tag="1" Command="{Binding SetViewModeCommand}" CommandParameter="1"/>
                            <Button Content="Mode 2 (8)" Style="{StaticResource ModeButtonStyle}" Tag="2" Command="{Binding SetViewModeCommand}" CommandParameter="2"/>
                            <Button Content="Mode 3 (4)" Style="{StaticResource ModeButtonStyle}" Tag="3" Command="{Binding SetViewModeCommand}" CommandParameter="3"/>
                            <Button Content="Mode 4 (2)" Style="{StaticResource ModeButtonStyle}" Tag="4" Command="{Binding SetViewModeCommand}" CommandParameter="4"/>
                            <Button Content="Mode 5 (1)" Style="{StaticResource ModeButtonStyle}" Tag="5" Command="{Binding SetViewModeCommand}" CommandParameter="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="컬러맵" Foreground="{StaticResource TextOnSurfaceVariant}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox MinWidth="120" SelectedIndex="{Binding ColorMapIndex, Mode=TwoWay}"
                                      Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}">
                                <ComboBoxItem Content="컬러"/>
                                <ComboBoxItem Content="그레이스케일"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Secondary}" Margin="0,0,8,0"/>
                            <TextBlock Text="LIVE" Foreground="{StaticResource TextOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentPageInfo}" Foreground="{StaticResource TextOnSurface}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding CameraFeeds}" Margin="12,0,12,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#080d15" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8" Margin="4"
                                    AllowDrop="True" DragEnter="Slot_DragEnter" Drop="Slot_Drop" PreviewMouseRightButtonDown="Slot_MouseRightButtonDown" ToolTip="Drag camera here to assign (Modes 2-5). Right click to clear.">
                                <Grid>
                                    <Border x:Name="EmptyStateBorder" Background="#080d15" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCamera}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="DRAG CAMERA HERE" Foreground="{StaticResource Outline}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                    </Border>

                                    <Grid x:Name="CameraFeedGrid">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCamera}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#131a2a" Padding="8,5" CornerRadius="8,8,0,0">
                                            <TextBlock Text="{Binding Camera.Id}" Foreground="{StaticResource Primary}" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Border Grid.Row="1" Background="#111624" Margin="8" CornerRadius="4" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Camera.LiveImage}" Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Camera.HasFreshLiveFrame}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="No Signal" Foreground="{StaticResource TextOnSurfaceVariant}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Camera.HasFreshLiveFrame}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,4">
                                            <TextBlock Text="{Binding Camera.CurrentTemperature, StringFormat={}{0:F1}}" Foreground="{StaticResource Primary}" FontSize="20" FontWeight="Bold"/>
                                            <TextBlock Text=" &#176;C" Foreground="{StaticResource Primary}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ─── COL 2 : AGENTS + RECIPE ─── -->
            <Border Grid.Column="2" Background="#10192a" BorderBrush="{StaticResource CardEdge}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="AGENTS · 카메라" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextOnSurface}"/>
                            <TextBlock Text="{Binding OnlineAgentCount, StringFormat={}{0} ONLINE}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="16,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#0b1220" Padding="10,6" Margin="0,6,0,4" CornerRadius="6" BorderBrush="{StaticResource CardEdge}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#47eaed" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="PC" FontSize="9" FontWeight="Bold" Foreground="#08131a"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" Foreground="#47eaed" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}({0})}" Foreground="#bac9c9" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Background="{StaticResource CardBg}">
                                        <StackPanel>
                                            <Border Background="#131a2a" Padding="10,8" CornerRadius="8,8,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextOnSurface}" FontSize="12" FontWeight="Bold"/>
                                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#859493"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Fill" Value="#4ae183"/>
                                                                        <Setter Property="Effect">
                                                                            <Setter.Value><DropShadowEffect Color="#4ae183" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Cameras}" Margin="6,4" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Padding="4"
                                                                PreviewMouseLeftButtonDown="CameraItem_PreviewMouseLeftButtonDown"
                                                                MouseMove="CameraItem_MouseMove"
                                                                Cursor="Hand" ToolTip="Drag to view feed">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#859493"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CameraStatus}" Value="Connected">
                                                                                    <Setter Property="Fill" Value="#47eaed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding CameraStatus}" Value="Streaming">
                                                                                    <Setter Property="Fill" Value="#4ae183"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{StaticResource TextOnSurface}" FontSize="14" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding CameraStatus}" Foreground="{StaticResource Outline}" FontSize="10" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#131a2a" BorderBrush="{StaticResource CardEdge}" BorderThickness="0,1,0,0" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RECIPE" Foreground="{StaticResource TextOnSurfaceVariant}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}"
                                          ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Name"/>
                                <Button Grid.Column="2" Content="&#8635;" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" Padding="10,4" Margin="8,0,0,0" Command="{Binding RefreshRecipesCommand}" ToolTip="레시피 목록 새로고침"/>
                            </Grid>
                            <TextBlock Text="{Binding RecipeStatus}" Foreground="{StaticResource TextOnSurfaceVariant}" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="START" Background="{StaticResource Secondary}" Foreground="#00210c" FontSize="20" FontWeight="Bold" Padding="0,12" Margin="0,0,0,8" BorderThickness="0" Command="{Binding StartRecipeCommand}">
                                <Button.Effect><DropShadowEffect Color="#4ae183" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Button.Effect>
                            </Button>
                            <ProgressBar Value="{Binding RecipeProgressValue}" Height="6" Foreground="{StaticResource Secondary}" Background="{StaticResource BgSurface}" BorderThickness="0" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding RecipePhaseText}" Foreground="{StaticResource TextOnSurfaceVariant}" FontSize="11" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="STOP" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource Error}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" Padding="0,8" Command="{Binding StopRecipeCommand}"/>
                                <Button Grid.Column="2" Content="CONFIG" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextOnSurface}" BorderBrush="{StaticResource OutlineVariant}" BorderThickness="1" Padding="0,8"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
