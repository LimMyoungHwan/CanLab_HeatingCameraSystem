<Window x:Class="HeatingCameraSystem.Master.Views.ProductionRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="560">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HintText" Grid.Row="0" Grid.ColumnSpan="3"
                   TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8"/>

        <TextBlock x:Name="SaveRootLabel" Grid.Row="1" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="SaveRootBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"/>
        <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Padding="12,4" Margin="0,0,0,8"
                Click="OnBrowse"/>

        <TextBlock x:Name="ProductLabel" Grid.Row="2" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="ProductBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"/>

        <TextBlock x:Name="PreviewText" Grid.Row="3" Grid.ColumnSpan="3"
                   TextWrapping="Wrap" Margin="0,4,0,12" FontFamily="Consolas" Opacity="0.7"/>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Grid.ColumnSpan="3"
                   TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#C62828" Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Padding="20,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button x:Name="CancelButton" Padding="20,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
