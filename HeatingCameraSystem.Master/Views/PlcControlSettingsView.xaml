<UserControl
    x:Class="HeatingCameraSystem.Master.Views.PlcControlSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="clr-namespace:HeatingCameraSystem.Core.Config;assembly=HeatingCameraSystem.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:HeatingCameraSystem.Master.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    Background="#0e1321"
    Foreground="#dee2f7"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#161b2a" />
            <Setter Property="BorderBrush" Value="#3b4949" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#47eaed" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#bac9c9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0e1321" />
            <Setter Property="Foreground" Value="#dee2f7" />
            <Setter Property="BorderBrush" Value="#3b4949" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0e1321" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#3b4949" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
        <Style x:Key="Apply" TargetType="Button">
            <Setter Property="Background" Value="#2f3444" />
            <Setter Property="Foreground" Value="#47eaed" />
            <Setter Property="BorderBrush" Value="#3b4949" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="FieldRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border
            Padding="14,8"
            Background="#1a1f2e"
            BorderBrush="#3b4949"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock Foreground="#bac9c9" Text="{Binding StatusMessage}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">
                <Border Width="360" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="{loc:Loc Plc_Connection}" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="110"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_IpAddress}" />
                            <TextBox Width="150" Text="{Binding PlcIpAddress}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="110"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_Port}" />
                            <TextBox Width="80" Text="{Binding PlcPort}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="110"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_Station}" />
                            <TextBox Width="60" Text="{Binding PlcStationNo}" />
                        </StackPanel>
                        <Button
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SavePlcConnectionCommand}"
                            Content="{loc:Loc Common_Save}"
                            Style="{StaticResource Apply}" />
                    </StackPanel>
                </Border>

                <Border Width="340" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="{loc:Loc Plc_BlackBodyConnTitle}" />
                        <CheckBox
                            Margin="0,0,0,10"
                            Content="{loc:Loc Plc_BlackBodyDirectControl}"
                            Foreground="#dee2f7"
                            IsChecked="{Binding BlackBodyEnabled}" />

                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="Bold"
                            Style="{StaticResource Lbl}"
                            Text="{loc:Loc Plc_BlackBody1}" />
                        <ComboBox
                            Margin="0,0,0,8"
                            ItemsSource="{Binding BlackBodyConnectionTypes}"
                            SelectedItem="{Binding BlackBody1.ConnectionType}" />
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlackBody1.ConnectionType}" Value="{x:Static config:BlackBodyConnectionType.Serial}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="{loc:Loc Plc_ComPort}" />
                                <TextBox Text="{Binding BlackBody1.PortName}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="Baud Rate" />
                                <TextBox Text="{Binding BlackBody1.BaudRate}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlackBody1.ConnectionType}" Value="{x:Static config:BlackBodyConnectionType.Ip}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="{loc:Loc Plc_IpAddress}" />
                                <TextBox Width="150" Text="{Binding BlackBody1.IpAddress}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="{loc:Loc Plc_Port}" />
                                <TextBox Text="{Binding BlackBody1.Port}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Margin="0,8,0,6"
                            FontWeight="Bold"
                            Style="{StaticResource Lbl}"
                            Text="{loc:Loc Plc_BlackBody2}" />
                        <ComboBox
                            Margin="0,0,0,8"
                            ItemsSource="{Binding BlackBodyConnectionTypes}"
                            SelectedItem="{Binding BlackBody2.ConnectionType}" />
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlackBody2.ConnectionType}" Value="{x:Static config:BlackBodyConnectionType.Serial}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="{loc:Loc Plc_ComPort}" />
                                <TextBox Text="{Binding BlackBody2.PortName}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="Baud Rate" />
                                <TextBox Text="{Binding BlackBody2.BaudRate}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlackBody2.ConnectionType}" Value="{x:Static config:BlackBodyConnectionType.Ip}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="{loc:Loc Plc_IpAddress}" />
                                <TextBox Width="150" Text="{Binding BlackBody2.IpAddress}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Width="110"
                                    Style="{StaticResource Lbl}"
                                    Text="{loc:Loc Plc_Port}" />
                                <TextBox Text="{Binding BlackBody2.Port}" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SaveBlackBodyConnectionCommand}"
                            Content="{loc:Loc Common_Save}"
                            Style="{StaticResource Apply}" />
                    </StackPanel>
                </Border>

                <Border Width="360" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="{loc:Loc Plc_ChamberBbTitle}" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="110"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Status_Bb1Target}" />
                            <TextBox Text="{Binding BlackBody1Target}" />
                            <Button
                                Command="{Binding ApplyBlackBody1Command}"
                                Content="{loc:Loc Common_Apply}"
                                Style="{StaticResource Apply}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="110"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Status_Bb2Target}" />
                            <TextBox Text="{Binding BlackBody2Target}" />
                            <Button
                                Command="{Binding ApplyBlackBody2Command}"
                                Content="{loc:Loc Common_Apply}"
                                Style="{StaticResource Apply}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Width="360" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="{loc:Loc Plc_AdminSettings}" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_OverheatLimit}" />
                            <TextBox Text="{Binding OverheatLimit}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_CoolerRoomBoundary}" />
                            <TextBox Text="{Binding CoolerRoomBoundary}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_Cooler2ndBoundary}" />
                            <TextBox Text="{Binding Cooler2ndBoundary}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_CoolerDelay}" />
                            <TextBox Text="{Binding CoolerDelayMinutes}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_BypassBoundary}" />
                            <TextBox Text="{Binding BypassBoundary}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_MfcMin}" />
                            <TextBox Text="{Binding MfcMinOutput}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_MfcMax}" />
                            <TextBox Text="{Binding MfcMaxOutput}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock
                                Width="150"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_PairGlassBoundary}" />
                            <TextBox Text="{Binding PairGlassBoundary}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding LoadAdminCommand}"
                                Content="{loc:Loc Common_Load}"
                                Style="{StaticResource Apply}" />
                            <Button
                                Command="{Binding SaveAdminCommand}"
                                Content="{loc:Loc Common_Save}"
                                Style="{StaticResource Apply}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Width="360" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Head}" Text="{loc:Loc Plc_ServoPointsTitle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding LoadPointsCommand}"
                                    Content="{loc:Loc Common_Load}"
                                    Style="{StaticResource Apply}" />
                                <Button
                                    Command="{Binding SavePointsCommand}"
                                    Content="{loc:Loc Common_Save}"
                                    Style="{StaticResource Apply}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource Lbl}"
                                Text="{loc:Loc Plc_Point}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource Lbl}"
                                Text="X" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource Lbl}"
                                Text="Y" />
                        </Grid>
                        <ItemsControl MaxHeight="360" ItemsSource="{Binding Points}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Foreground="#dee2f7"
                                            Text="{Binding Index}" />
                                        <TextBox Grid.Column="1" Text="{Binding X}" />
                                        <TextBox Grid.Column="2" Text="{Binding Y}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
