<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HeatingCameraSystem.Core\HeatingCameraSystem.Core.csproj" />
    <ProjectReference Include="..\HeatingCameraSystem.Protocols\HeatingCameraSystem.Protocols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeatingCameraSystem.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="NATS.Net" Version="2.8.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
    <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\canlab.ico</ApplicationIcon>
    <!-- NU1701: ScottPlot.WPF가 끌고 오는 SkiaSharp.Views.WPF는 net462 자산만 게시한다.
         WPF 렌더링은 정상 동작하므로 복원 경고만 끈다. 이 프로젝트에서 프레임워크가
         어긋난 패키지는 이것뿐이며, 새 패키지를 넣을 때는 이 억제가 가리지 않는지 확인할 것. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\canlab-logo.png" />
    <None Remove="Assets\canlab.ico" />
    <Resource Include="Assets\canlab-logo.png" />
    <Resource Include="Assets\canlab.ico" />
    <None Update="Resources\Lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
