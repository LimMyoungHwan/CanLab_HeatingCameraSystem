<Window x:Class="HeatingCameraSystem.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeatingCameraSystem.Master"
        xmlns:vm="clr-namespace:HeatingCameraSystem.Master.ViewModels"
        xmlns:views="clr-namespace:HeatingCameraSystem.Master.Views"
        xmlns:conv="clr-namespace:HeatingCameraSystem.Master.Converters"
        xmlns:loc="clr-namespace:HeatingCameraSystem.Master.Localization"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="{loc:Loc Window_Title}" Icon="/Assets/canlab.ico" Height="768" Width="1024" Background="#F5F6FA">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipeEditorViewModel}">
            <views:RecipeEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgentSettingsViewModel}">
            <views:AgentSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatusMonitorViewModel}">
            <views:StatusMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlcControlSettingsViewModel}">
            <views:PlcControlSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManualControlViewModel}">
            <views:ManualControlView />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToBrushConverter x:Key="Lamp" OnBrush="#4ae183" OffBrush="#33404a"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" Background="#2F3542" Padding="20">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel.Resources>
                        <Style x:Key="NavBtn" TargetType="Button">
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="#57606f"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="12,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <Border Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Image Source="/Assets/canlab-logo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{loc:Loc Nav_Subtitle}" Foreground="{StaticResource BrandBlue}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <TextBlock Text="{loc:Loc Nav_Language}" Foreground="#9fb0c0" FontSize="12" Margin="2,0,0,4"/>
                    <ComboBox Margin="0,0,0,16"
                              ItemsSource="{Binding AvailableLanguages, Source={x:Static loc:LocalizationManager.Instance}}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                              SelectedValue="{Binding CurrentLanguage, Source={x:Static loc:LocalizationManager.Instance}, Mode=TwoWay}"/>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="ViewDashboard" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_Dashboard}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToRecipeEditorCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="FileDocumentEditOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_RecipeEditor}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="History" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_History}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToAgentSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Cctv" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_AgentSettings}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToStatusMonitorCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Gauge" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_PlcStatus}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToPlcControlSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_PlcSettings}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateToManualControlCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Gesture" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Loc Nav_ManualControl}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding PlcStatus}">
                    <Border BorderBrush="#3b4949" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Loc Nav_EquipmentStatus}" Foreground="#9fb0c0" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <Border Background="#7a2020" CornerRadius="3" Padding="8,3" Margin="0,0,0,10" HorizontalAlignment="Left"
                            Visibility="{Binding IsEmergencyStop, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="비상정지" Foreground="#ffd9d6" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding IsConnected, Converter={StaticResource Lamp}}"/>
                        <TextBlock Text="PLC" Foreground="White" FontWeight="Bold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#8fa0b0" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Snapshot.CurrentTemperature, StringFormat='온도 {0:0.0}℃'}" Foreground="#47eaed" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Snapshot.CurrentHumidity, StringFormat='습도 {0:0.0}%'}" Foreground="#47eaed" FontSize="13" FontWeight="Bold" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Snapshot.ServoXPosition, StringFormat='서보  X {0}'}" Foreground="#bac9c9" FontSize="12"/>
                        <TextBlock Text="{Binding Snapshot.ServoYPosition, StringFormat='Y {0}'}" Foreground="#bac9c9" FontSize="12" Margin="10,0,0,0"/>
                    </StackPanel>

                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.Heater, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="히터" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.Cooler1st, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="1차 냉동기" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.Cooler2nd, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="2차 냉동기" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.CoolerRoom, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="상온 냉동기" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.CoolerRoomBypass, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="바이패스" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.Blower1, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="블로워1" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.Blower2, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="블로워2" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.Mcf, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="MCF" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.DoorLamp, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="도어" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Snapshot.PairGlass, Converter={StaticResource Lamp}}"/>
                            <TextBlock Text="페어글라스" Foreground="#bac9c9" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="{Binding CurrentViewTitle}" FontSize="28" FontWeight="SemiBold" Foreground="#2f3542" Margin="0,0,0,20"/>
            
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
