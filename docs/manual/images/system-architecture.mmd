%%{init: {"theme":"base","themeVariables":{"fontFamily":"Malgun Gothic","fontSize":"15px","lineColor":"#555555"}}}%%
flowchart LR
    OP(["운영자"]):::actor

    subgraph MASTER["Master PC · WPF (.NET 8-windows)"]
      direction TB
      UI["운영자 GUI<br/>Dashboard · Recipe Editor<br/>Camera Mapping · History · Serial Settings"]
      ENG["RecipeEngine<br/>레시피 실행 오케스트레이션"]
      DB[("LiteDB · data.db<br/>Recipe / Mapping / 캡처 이력")]
      UI --> ENG
      ENG --> DB
    end

    subgraph FIELD["현장 하드웨어 (PLC 직결)"]
      direction TB
      PLC["PLC · LS XGT FEnet (TCP 2004)<br/>챔버 온·습도 / 서보 2축 / 흑체"]
    end

    NATS{{"NATS Server<br/>Docker · 4222 / 8222"}}:::broker

    subgraph AGENTS["Agent PC #1 … #N (.NET 8)"]
      direction TB
      CAM["USB-C 열화상 카메라<br/>연결 시 가상 시리얼 포트(COM) 노출"]
      AG["Agent 콘솔 앱 / AgentUI<br/>OpenCvSharp4 캡처 + 셔터 시리얼"]
      SH["시리얼 셔터 open/close<br/>7-byte @ 카메라 가상 COM"]:::hw
      CAM --> AG
      AG -->|"가상 COM"| SH
    end

    MGR["AgentManager (PC당 1개)<br/>WMI 카메라 자동 발견 · Agent 감독 · 로그 수집"]:::mgr

    OP --> UI
    ENG -->|"제어 · 1초 폴링"| PLC
    ENG <-->|"master.cmd.capture.*<br/>카메라-op: 셔터 open/close"| NATS
    NATS <-->|"agent.result.capture.*<br/>agent.status.* (5초 주기)"| AG
    MGR <-->|"agent-mgr.inventory / log<br/>server.cmd.mgr<br/>master.config.serial.* (셔터 포트)"| NATS
    MGR -.->|"프로세스 supervisor"| AG

    classDef actor fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef broker fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef mgr fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef hw fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
