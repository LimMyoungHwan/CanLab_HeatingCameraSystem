<Window x:Class="HeatingCameraSystem.AgentUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HeatingCameraSystem.AgentUI.Localization"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="{loc:Loc Window_Title}" Icon="/Assets/canlab.ico" Height="680" Width="1040"
        Background="#1E1E1E">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D6FB4"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- ComboBoxItem: dark popup rows (implicit TextBlock foreground leaked into the
             default white combo chrome => white-on-white; retemplate dark) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: dark control template that respects Background (fixes white chrome) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MainBorder" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                            <ToggleButton Grid.ColumnSpan="2" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Path x:Name="Arrow" Grid.Column="1" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextBrush}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#2B2B2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,2,0,0">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="#262626"/>
            <Setter Property="AlternatingRowBackground" Value="#2C2C2C"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Bd" Background="#2A2A2A" BorderBrush="#3C3C3C" BorderThickness="1,1,1,0"
                                Margin="0,0,2,0" Padding="16,6" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

        <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="12,10,12,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Nav_Language}" VerticalAlignment="Center" Foreground="#B0B0B0" Margin="0,0,6,0"/>
                <ComboBox Width="130"
                          ItemsSource="{Binding AvailableLanguages, Source={x:Static loc:LocalizationManager.Instance}}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                          SelectedValue="{Binding CurrentLanguage, Source={x:Static loc:LocalizationManager.Instance}, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="{Binding HeaderText}"
                       Foreground="#E0E0E0" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <TabControl Background="#1E1E1E" BorderBrush="#3C3C3C" Margin="6">

            <TabItem>
                <TabItem.Header>
                    <materialIcons:MaterialIconText Kind="Video" Text="{loc:Loc Tab_Live}" Spacing="6"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cameras}" Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="6" CornerRadius="6"
                                        Background="#2A2A2A" BorderBrush="#3C3C3C" BorderThickness="1">
                                    <StackPanel Width="340">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F0F0F0" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                        <Border Background="Black" Height="255">
                                            <Image Source="{Binding LiveImage}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Margin="2,6,0,0" Foreground="#B0B0B0">
                                            <Run Text="{loc:Loc Cam_Status}"/><Run Text=" "/><Run Text="{Binding Status}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2,8,0,0">
                                            <Button Command="{Binding RestartCommand}" Padding="12,3">
                                                <materialIcons:MaterialIconText Kind="Restart" Text="{loc:Loc Cam_Restart}" Spacing="6"/>
                                            </Button>
                                            <Button Command="{Binding CaptureSaveCommand}" Padding="12,3" Margin="6,0,0,0">
                                                <materialIcons:MaterialIconText Kind="ContentSave" Text="{loc:Loc Cam_CaptureSave}" Spacing="6"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CaptureStatus}" Foreground="#B0B0B0" Margin="2,4,0,0" TextWrapping="Wrap"/>
                                        <Border Margin="2,10,0,0" Padding="0,8,0,0" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                                                Visibility="{Binding HasSerialControl, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Cam_SerialControl}" Foreground="#B0B0B0" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                                <Grid Margin="2,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="S/N: " Foreground="#909090"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FPA: " Foreground="#909090"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FpaTemperature}"/>
                                                </Grid>
                                                <WrapPanel Margin="2,2,0,0">
                                                    <Button Command="{Binding OpenShutterCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="Eye" Text="{loc:Loc Cam_ShutterOpen}" Spacing="6"/>
                                                    </Button>
                                                    <Button Command="{Binding CloseShutterCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="EyeOff" Text="{loc:Loc Cam_ShutterClose}" Spacing="6"/>
                                                    </Button>
                                                    <Button Command="{Binding RunCameraCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="Play" Text="{loc:Loc Cam_Run}" Spacing="6"/>
                                                    </Button>
                                                    <Button Command="{Binding StopCameraCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="Stop" Text="{loc:Loc Cam_Stop}" Spacing="6"/>
                                                    </Button>
                                                    <Button Command="{Binding RefreshInfoCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="Information" Text="{loc:Loc Cam_ReadInfo}" Spacing="6"/>
                                                    </Button>
                                                    <Button Command="{Binding SaveConfigCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="ContentSaveOutline" Text="{loc:Loc Cam_SaveConfig}" Spacing="6"/>
                                                    </Button>
                                                    <Button Command="{Binding RunNucCommand}" Margin="0,0,4,4" Padding="8,3">
                                                        <materialIcons:MaterialIconText Kind="Tune" Text="{loc:Loc Cam_Nuc}" Spacing="6"/>
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding SerialStatus}" Foreground="#B0B0B0" Margin="2,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <materialIcons:MaterialIconText Kind="Database" Text="{loc:Loc Tab_Data}" Spacing="6"/>
                </TabItem.Header>
                <Grid Margin="6" DataContext="{Binding DataBrowser}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Captures}"
                              SelectedItem="{Binding Selected}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Data_ColTime}" Width="150"
                                                Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                            <DataGridTextColumn Header="{loc:Loc Data_ColAgent}" Width="*" Binding="{Binding AgentId}"/>
                            <DataGridTextColumn Header="{loc:Loc Data_ColCam}" Width="46" Binding="{Binding CameraIndex}"/>
                            <DataGridTextColumn Header="{loc:Loc Data_ColSize}" Width="80">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}×{1}">
                                        <Binding Path="Width"/>
                                        <Binding Path="Height"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Data_ColMin}" Width="60" Binding="{Binding Min}"/>
                            <DataGridTextColumn Header="{loc:Loc Data_ColMax}" Width="60" Binding="{Binding Max}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Border Background="Black" Height="255">
                            <Image Source="{Binding Preview}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding RefreshCommand}">
                                <materialIcons:MaterialIconText Kind="Refresh" Text="{loc:Loc Data_Refresh}" Spacing="6"/>
                            </Button>
                            <Button Command="{Binding DeleteSelectedCommand}" Margin="6,0,0,0">
                                <materialIcons:MaterialIconText Kind="Delete" Text="{loc:Loc Data_DeleteSelected}" Spacing="6"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Loc Data_Retention}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding RetentionDays}" Width="50"/>
                            <Button Command="{Binding PurgeCommand}" Margin="6,0,0,0">
                                <materialIcons:MaterialIconText Kind="DeleteSweep" Text="{loc:Loc Data_PurgeOld}" Spacing="6"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="#B0B0B0"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <materialIcons:MaterialIconText Kind="FormatListBulleted" Text="{loc:Loc Tab_Logs}" Spacing="6"/>
                </TabItem.Header>
                <DockPanel Margin="6" DataContext="{Binding Logs}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc Logs_MinLevel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinLevel}" Width="130"/>
                        <Button Command="{Binding RefreshCommand}" Margin="8,0,0,0">
                            <materialIcons:MaterialIconText Kind="Refresh" Text="{loc:Loc Logs_Refresh}" Spacing="6"/>
                        </Button>
                        <TextBlock Text="{Binding StatusText}" Foreground="#B0B0B0"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Entries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Logs_ColTime}" Width="150"
                                                Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                            <DataGridTextColumn Header="{loc:Loc Logs_ColLevel}" Width="90" Binding="{Binding Level}"/>
                            <DataGridTextColumn Header="{loc:Loc Logs_ColMessage}" Width="*" Binding="{Binding Message}"/>
                            <DataGridTextColumn Header="{loc:Loc Logs_ColException}" Width="220" Binding="{Binding Exception}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <materialIcons:MaterialIconText Kind="Cog" Text="{loc:Loc Tab_Settings}" Spacing="6"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" DataContext="{Binding Settings}">
                        <CheckBox Content="{loc:Loc Set_SimulationMode}"
                                  IsChecked="{Binding SimulationMode}" Margin="0,0,0,10"/>
                        <TextBlock Text="{loc:Loc Set_NatsUrl}"/>
                        <TextBox Text="{Binding NatsUrl}" Width="360" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                        <TextBlock Text="{loc:Loc Set_StoragePath}"/>
                        <TextBox Text="{Binding StoragePath}" Width="360" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                        <TextBlock Text="{loc:Loc Set_Heartbeat}"/>
                        <TextBox Text="{Binding HeartbeatSeconds}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                        <TextBlock Text="{loc:Loc Set_ImageFormat}"/>
                        <ComboBox ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding CaptureImageFormat}"
                                  Width="160" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                        <TextBlock Text="{loc:Loc Set_CaptureBurst}"/>
                        <TextBox Text="{Binding CaptureBurstCount}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                        <TextBlock Text="{loc:Loc Set_Cameras}" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <DataGrid ItemsSource="{Binding Cameras}" IsReadOnly="False" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Set_ColAgentId}" Width="*" Binding="{Binding AgentId}"/>
                                <DataGridTextColumn Header="{loc:Loc Set_ColOpenCvIndex}" Width="110" Binding="{Binding OpenCvIndex}"/>
                                <DataGridTextColumn Header="{loc:Loc Set_ColAlias}" Width="*" Binding="{Binding Alias}"/>
                                <DataGridTextColumn Header="{loc:Loc Set_ColDeviceName}" Width="*" Binding="{Binding DeviceName}"/>
                                <DataGridTextColumn Header="{loc:Loc Set_ColSerialCom}" Width="100" Binding="{Binding SerialPortName}"/>
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Loc Set_Remove}"
                                                    Command="{Binding DataContext.RemoveCameraCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding AddCameraCommand}">
                                <materialIcons:MaterialIconText Kind="Plus" Text="{loc:Loc Set_AddCamera}" Spacing="6"/>
                            </Button>
                            <Button Command="{Binding AutoDetectSerialCommand}" Margin="6,0,0,0">
                                <materialIcons:MaterialIconText Kind="Magnify" Text="{loc:Loc Set_AutoDetectCom}" Spacing="6"/>
                            </Button>
                            <Button Command="{Binding SaveCommand}" Margin="6,0,0,0">
                                <materialIcons:MaterialIconText Kind="ContentSave" Text="{loc:Loc Set_Save}" Spacing="6"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="#B0B0B0" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
