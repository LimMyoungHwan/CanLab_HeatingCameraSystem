  <property name="styleSheet">
   <string notr="true">* { outline: none; }
QMainWindow, #appRoot, #contentArea { background: #f4f7fb; color: #172033; }
QMenuBar { background: #101827; color: #cbd5e1; border: 0; padding: 2px 8px; }
QMenuBar::item:selected, QMenu::item:selected { background: #26334a; }
QMenu { background: #ffffff; color: #172033; border: 1px solid #dbe2ec; padding: 6px; }
#sidebar { background: #101827; }
#brandMark { background: #2dd4bf; color: #0f172a; border-radius: 10px; font-size: 20px; font-weight: 800; }
#brandText { color: #f8fafc; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
#sidebarSection, #deviceTitle { color: #71809a; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
#navCameraButton, #navFirmwareButton, #navPwmButton { min-height: 44px; padding: 6px 10px; color: #91a0b8; background: transparent; border: 0; border-radius: 8px; text-align: left; font-size: 12px; }
#navCameraButton:hover, #navFirmwareButton:hover, #navPwmButton:hover { color: #e2e8f0; background: #172238; }
#navCameraButton:checked, #navFirmwareButton:checked, #navPwmButton:checked { color: #ffffff; background: #22304a; border-left: 3px solid #2dd4bf; font-weight: 600; }
#deviceCard { background: #172238; border: 1px solid #26354f; border-radius: 10px; }
#connectionBadge { color: #94a3b8; font-size: 11px; }
#connectionBadge[connected=&quot;true&quot;] { color: #5eead4; }
#versionLabel { color: #52617a; font-size: 10px; padding-top: 8px; }
#pageTitle { color: #162033; font-size: 24px; font-weight: 700; }
#pageSubtitle { color: #68758b; font-size: 12px; }
#helpButton { color: #526178; background: #ffffff; border: 1px solid #dbe2ec; border-radius: 18px; font-weight: 700; }
#helpButton:hover { color: #0f766e; border-color: #5eead4; }
QGroupBox { background: #ffffff; border: 1px solid #dfe6ef; border-radius: 9px; margin-top: 13px; padding-top: 8px; font-weight: 600; color: #243047; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 12px; padding: 0 6px; background: #ffffff; color: #344157; }
QLabel { color: #445066; background: transparent; }
QPushButton { min-height: 30px; padding: 2px 12px; color: #344157; background: #ffffff; border: 1px solid #cfd8e5; border-radius: 6px; }
QPushButton:hover { color: #0f766e; background: #f0fdfa; border-color: #5eead4; }
QPushButton:pressed { background: #ccfbf1; }
QPushButton:disabled { color: #a7b0bf; background: #f3f5f8; border-color: #e1e6ed; }
QPushButton[role=&quot;primary&quot;] { color: #ffffff; background: #0f766e; border-color: #0f766e; font-weight: 600; }
QPushButton[role=&quot;primary&quot;]:hover { background: #0d9488; border-color: #0d9488; }
QPushButton[role=&quot;danger&quot;] { color: #b42318; background: #fff5f4; border-color: #fecaca; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 30px; padding: 1px 8px; color: #243047; background: #f9fbfd; border: 1px solid #cfd8e5; border-radius: 6px; selection-background-color: #99f6e4; }
QLineEdit:focus, QComboBox:focus { background: #ffffff; border-color: #14b8a6; }
QLineEdit:read-only { color: #657188; background: #f2f5f8; }
QComboBox::drop-down { width: 24px; border: 0; }
QTabWidget::pane { background: #ffffff; border: 1px solid #dfe6ef; border-radius: 9px; top: -1px; }
QTabBar::tab { min-width: 88px; min-height: 34px; padding: 2px 10px; color: #6b778c; background: #e9eef5; border: 1px solid #d9e1eb; border-bottom: 0; border-top-left-radius: 7px; border-top-right-radius: 7px; margin-right: 3px; }
QTabBar::tab:selected { color: #0f766e; background: #ffffff; font-weight: 700; border-top: 2px solid #14b8a6; }
QScrollArea, QAbstractScrollArea::viewport { background: #ffffff; border: 0; }
QScrollBar:vertical { width: 10px; background: #f1f4f8; margin: 2px; }
QScrollBar::handle:vertical { min-height: 36px; background: #c4cfdd; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; background: transparent; }
QSlider::groove:horizontal { height: 4px; background: #dce3ec; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #14b8a6; border-radius: 2px; }
QSlider::handle:horizontal { width: 15px; margin: -6px 0; background: #ffffff; border: 2px solid #0f766e; border-radius: 8px; }
QProgressBar { min-height: 16px; color: #243047; background: #e8edf3; border: 0; border-radius: 8px; text-align: center; }
QProgressBar::chunk { background: #14b8a6; border-radius: 8px; }</string>
